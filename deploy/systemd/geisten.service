[Unit]
Description=geisten local model service
After=network.target

[Service]
Type=simple
ExecStart=/usr/lib/geisten/geist-app
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
StandardOutput=null
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
Environment=XDG_DATA_HOME=%h/.local/share
# geisten's data folder; the earlier geist folder stays writable until it is moved (#92).
ReadWritePaths=%h/.local/share/geisten
ReadWritePaths=-%h/.local/share/geist
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=default.target
