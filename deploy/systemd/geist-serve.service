# The model path comes from /etc/default/geist-serve (GEIST_MODEL=...).
# Serial by design: one request at a time on one process; see README.
[Unit]
Description=geist-serve: one GGUF behind an Ollama/OpenAI-compatible HTTP API
Documentation=https://github.com/geisten/geist-serve
Requires=geist-serve.socket
After=geist-serve.socket

[Service]
EnvironmentFile=-/etc/default/geist-serve
ExecStart=/usr/local/bin/geist-serve $GEIST_MODEL $GEIST_ARGS
# Foreground daemon: no fork, logs on stderr → journal, SIGTERM to stop.
Type=exec
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=2
# Nothing to write, so nothing writable: the GGUF is mmapped read-only.
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# OpenMP threads: leave one core to the OS on a Pi 5.
Environment=OMP_NUM_THREADS=4 OMP_WAIT_POLICY=active

[Install]
WantedBy=multi-user.target
